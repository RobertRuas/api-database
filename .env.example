# ============================================================
# API DataBase — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores reais.
# ============================================================

# Servidor HTTP
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# URL pública da API (usada em links do painel e CORS)
PUBLIC_URL=http://localhost:3000

# Banco de dados PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_database

# Diretório raiz onde os arquivos enviados serão salvos (absoluto ou relativo)
STORAGE_ROOT=./storage

# Limite de upload por arquivo (bytes). 100 MB por padrão.
MAX_FILE_SIZE=104857600

# Segurança — gere strings longas e aleatórias (openssl rand -hex 32)
SESSION_SECRET=troque-isto-por-uma-string-longa-e-aleatoria
COOKIE_NAME=apidb_session

# Admin do painel (defina um usuário e uma senha em texto puro aqui
# — ela é lida uma vez no boot, comparada por hash em memória).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Rate limit global (por chave de API ou, se ausente, por IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Rate limit do painel de login (por IP). Protege contra brute-force.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=1 minute

# Origens permitidas pelo CORS (CSV). Use "*" só em desenvolvimento sem cookies.
# Em produção, liste explicitamente: https://app.exemplo.com,https://admin.exemplo.com
ALLOWED_ORIGINS=*

# Limites semânticos do payload JSON dos documentos
JSON_MAX_BYTES=1048576        # 1 MiB
JSON_MAX_DEPTH=32
JSON_MAX_KEYS=5000

# Retenção de versões por documento. 0 = sem limite.
DOC_VERSION_RETENTION=100

# Duração da sessão do painel (segundos). Padrão 8h.
SESSION_MAX_AGE_SECONDS=28800

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
